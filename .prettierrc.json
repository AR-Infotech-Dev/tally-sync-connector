{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "strict",
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": "*.hbs",
      "options": { "parser": "html" }
    }
  ]
}
