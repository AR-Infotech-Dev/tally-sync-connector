{{!-- All Sales / Sales Order XML is local to this voucher. Conditions control optional sections. --}}
<TALLYMESSAGE xmlns:UDF="TallyUDF">
  <VOUCHER VCHTYPE="{{{voucherType}}}" ACTION="Create" OBJVIEW="{{voucherView}}">
    <DATE>{{date}}</DATE>
    <VCHSTATUSDATE>{{date}}</VCHSTATUSDATE>
    <VOUCHERTYPENAME>{{{voucherType}}}</VOUCHERTYPENAME>
    <VOUCHERNUMBER>{{{voucherNo}}}</VOUCHERNUMBER>
    {{#if isOrder}}<REFERENCE>{{{reference}}}</REFERENCE>{{/if}}
    <PARTYLEDGERNAME>{{{party}}}</PARTYLEDGERNAME>
    {{#if partyDetails.gst_registration_type}}<GSTREGISTRATIONTYPE>{{{partyDetails.gst_registration_type}}}
    </GSTREGISTRATIONTYPE>{{/if}}
    {{#if companyDetails.state}}<STATENAME>{{{companyDetails.state}}}</STATENAME>{{/if}}
    {{#if partyDetails.country}}<COUNTRYOFRESIDENCE>{{{partyDetails.country}}}</COUNTRYOFRESIDENCE>{{/if}}
    {{#if placeOfSupply}}<PLACEOFSUPPLY>{{{placeOfSupply}}}</PLACEOFSUPPLY>{{/if}}
    {{#if companyDetails.gst_registration}}<GSTREGISTRATION TAXTYPE="GST" TAXREGISTRATION="{{{companyDetails.gstin}}}">
      {{{companyDetails.gst_registration}}}</GSTREGISTRATION>{{/if}}
    {{#if companyDetails.gstin}}<CMPGSTIN>{{{companyDetails.gstin}}}</CMPGSTIN>{{/if}}
    {{#if companyDetails.gst_registration_type}}<CMPGSTREGISTRATIONTYPE>{{{companyDetails.gst_registration_type}}}
    </CMPGSTREGISTRATIONTYPE>{{/if}}
    {{#if companyDetails.state}}<CMPGSTSTATE>{{{companyDetails.state}}}</CMPGSTSTATE>{{/if}}
    <PARTYNAME>{{{buyerName}}}</PARTYNAME>
    <BASICBUYERNAME>{{{buyerMailingName}}}</BASICBUYERNAME>
    <PARTYMAILINGNAME>{{{mailingName}}}</PARTYMAILINGNAME>
    {{#if partyDetails.pincode}}<PARTYPINCODE>{{{partyDetails.pincode}}}</PARTYPINCODE>{{/if}}
    {{#if partyDetails.state}}<STATENAME>{{{partyDetails.state}}}</STATENAME>{{/if}}
    {{#if partyDetails.country}}<COUNTRYOFRESIDENCE>{{{partyDetails.country}}}</COUNTRYOFRESIDENCE>{{/if}}
    {{#if partyDetails.gstin}}<PARTYGSTIN>{{{partyDetails.gstin}}}</PARTYGSTIN>{{/if}}
    {{#if partyDetails.gst_registration_type}}<GSTREGISTRATIONTYPE>{{{partyDetails.gst_registration_type}}}
    </GSTREGISTRATIONTYPE>
    <VATDEALERTYPE>{{{partyDetails.gst_registration_type}}}</VATDEALERTYPE>{{/if}}
    <ADDRESS.LIST TYPE="String">{{#each addresses}}<ADDRESS>{{{this}}}</ADDRESS>{{/each}}</ADDRESS.LIST>
    <BASICBASEPARTYNAME>{{{mailingName}}}</BASICBASEPARTYNAME>
    {{#if consignee.name}}<CONSIGNEEMAILINGNAME>{{{consignee.name}}}</CONSIGNEEMAILINGNAME>
    {{#if consignee.pincode}}<CONSIGNEEPINCODE>{{{consignee.pincode}}}</CONSIGNEEPINCODE>{{/if}}
    {{#if consignee.state}}<CONSIGNEESTATENAME>{{{consignee.state}}}</CONSIGNEESTATENAME>{{/if}}
    {{#if consignee.country}}<CONSIGNEECOUNTRYNAME>{{{consignee.country}}}</CONSIGNEECOUNTRYNAME>{{/if}}
    {{/if}}
    <ISINVOICE>{{isInvoice}}</ISINVOICE>
    <PERSISTEDVIEW>{{voucherView}}</PERSISTEDVIEW>
    {{#unless isOrder}}<VCHENTRYMODE>{{{voucherMode}}}</VCHENTRYMODE>{{/unless}}
    <EFFECTIVEDATE>{{date}}</EFFECTIVEDATE>
    <DIFFACTUALQTY>No</DIFFACTUALQTY>
    {{#each entries}}
    <ALLINVENTORYENTRIES.LIST>
      <STOCKITEMNAME>{{{name}}}</STOCKITEMNAME>
      {{#if supplyType}}<GSTOVRDNTYPEOFSUPPLY>{{{supplyType}}}</GSTOVRDNTYPEOFSUPPLY>{{/if}}
      {{#if taxability}}<GSTOVRDNTAXABILITY>{{{taxability}}}</GSTOVRDNTAXABILITY>{{/if}}
      {{#if hsn}}<GSTHSNNAME>{{{hsn}}}</GSTHSNNAME>{{/if}}
      <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
      <ISLASTDEEMEDPOSITIVE>No</ISLASTDEEMEDPOSITIVE>
      <RATE>{{{rate}}}</RATE>
      <AMOUNT>{{{amount}}}</AMOUNT>
      <ACTUALQTY>{{{quantity}}}</ACTUALQTY>
      <BILLEDQTY>{{{quantity}}}</BILLEDQTY>
      {{#if hasBatch}}<BATCHALLOCATIONS.LIST>
        {{#if manufacturedOn}}<MFDON>{{manufacturedOn}}</MFDON>{{/if}}
        <GODOWNNAME>{{{godown}}}</GODOWNNAME>
        <BATCHNAME>{{{batchName}}}</BATCHNAME>
        {{#if @root.isOrder}}<ORDERNO>{{{orderNo}}}</ORDERNO>{{else}}<DESTINATIONGODOWNNAME>{{{godown}}}
        </DESTINATIONGODOWNNAME>{{/if}}
        <AMOUNT>{{{amount}}}</AMOUNT>
        <ACTUALQTY>{{{quantity}}}</ACTUALQTY>
        <BILLEDQTY>{{{quantity}}}</BILLEDQTY>
        {{#if dueDate}}<ORDERDUEDATE JD="{{dueDate.julianDay}}" P="{{dueDate.display}}">{{dueDate.display}}
        </ORDERDUEDATE>{{/if}}
        {{#if expiry}}<EXPIRYPERIOD>{{{expiry}}}</EXPIRYPERIOD>{{/if}}
      </BATCHALLOCATIONS.LIST>{{/if}}
      {{#if salesLedger}}<ACCOUNTINGALLOCATIONS.LIST>
        <LEDGERNAME>{{{salesLedger}}}</LEDGERNAME>
        <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
        <AMOUNT>{{{amount}}}</AMOUNT>
      </ACCOUNTINGALLOCATIONS.LIST>{{/if}}
    </ALLINVENTORYENTRIES.LIST>
    {{/each}}
    <LEDGERENTRIES.LIST>
      <LEDGERNAME>{{{partyLedger}}}</LEDGERNAME>
      <ISDEEMEDPOSITIVE>{{partyPositive}}</ISDEEMEDPOSITIVE>
      <ISPARTYLEDGER>Yes</ISPARTYLEDGER>
      <ISLASTDEEMEDPOSITIVE>{{partyPositive}}</ISLASTDEEMEDPOSITIVE>
      <AMOUNT>{{{partyAmount}}}</AMOUNT>
      {{#if billReference}}<BILLALLOCATIONS.LIST>
        <NAME>{{{billReference}}}</NAME>
        <BILLTYPE>{{{billType}}}</BILLTYPE>
        <AMOUNT>{{{partyAmount}}}</AMOUNT>
      </BILLALLOCATIONS.LIST>{{/if}}
    </LEDGERENTRIES.LIST>
    {{#each customFields}}
    <UDF:{{name}}>{{{value}}}</UDF:{{name}}>
    {{/each}}
  </VOUCHER>
</TALLYMESSAGE>