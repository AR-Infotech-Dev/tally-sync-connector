# Copy this file to .env.release on the computer that builds the Connector.
# Use only the server origin (HTTPS host and optional port), without a path.
# Leave the URL empty for local installer builds without an upload.
CONNECTOR_RELEASE_SERVER_URL=https://sync.flowups.in
# Use the same secret as CONNECTOR_RELEASE_TOKEN on the Server (at least 32 characters).
CONNECTOR_RELEASE_TOKEN=
# Optional: maximum upload/response wait in milliseconds (default 10 minutes).
CONNECTOR_RELEASE_TIMEOUT_MS=600000
